ADMIN_EMAIL=admin@example.com
# Prefer ADMIN_PASSWORD_HASH in production. ADMIN_PASSWORD is supported for local setup only.
ADMIN_PASSWORD=change-this-password
# ADMIN_PASSWORD_HASH=$2b$12$replace-with-bcrypt-hash

# AI search uses a 5-second Gemini timeout and reads at most 300 records
# per request to prevent slow/unbounded searches.
# GEMINI_MODEL=gemini-2.5-flash